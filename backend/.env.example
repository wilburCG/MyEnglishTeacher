# 复制为 .env 并按需填写
APP_ENV=dev
DATABASE_URL=postgresql+psycopg://met:met_dev_pwd@met-postgres:5432/met

# 火山方舟 ARK（agent-plan 端点；M3 实测 doubao-seed-2.0-lite 英文纠错 JSON 稳定）
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3
ARK_MODEL=doubao-seed-2.0-lite

# 火山语音评测（M5）
VOLC_SPEECH_APPID=
VOLC_SPEECH_TOKEN=
